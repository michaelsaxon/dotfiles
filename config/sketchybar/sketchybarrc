CRT_AMBER=FFB000

graph_options=(
	icon.font.size=16
	label.font.size=12
	graph.color=$FOREGROUND
	icon.color=$FOREGROUND
	label.color=$FOREGROUND
	background.color=$BLACK
	background.drawing="on"
	graph.line_width=2
	graph.fill_color="0x00000000"
	label.width=0
	icon.width=0
	icon.align=left
	label.align=right
	icon.padding_left=7
	label.padding_right=3
	label.drawing="off"
	icon.drawing="on"
)

# 60 wide max, 25 wide min
sketchybar --add graph cpug right 30 \
	   --set cpug label="CPU" "${bubble_outline[@]}" "${graph_options[@]}" \
           --set cpug --set cpug  update_freq=1 \
                      icon=  \
                      script="$PLUGIN_DIR/cpu_graph.sh" \
           --subscribe cpug mouse.entered mouse.exited 

sketchybar --add graph ramg right 30 \
	   --set ramg label="RAM" "${bubble_outline[@]}" "${graph_options[@]}" \
           --set ramg update_freq=1 \
                      icon=  \
                      script="$PLUGIN_DIR/ram_graph.sh" \
           --subscribe ramg mouse.entered mouse.exited

sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" label.drawing="on" \
           --subscribe volume volume_change mouse.clicked \
	   --set volume label.align=left icon.width=20 icon.align=left "${bubble_outline[@]}" \
		 icon.padding_right=10 label.padding_left=12 label.font.size=12 label.y_offset=1

# reading input method
