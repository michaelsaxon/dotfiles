	--set spacer label=" " label.font.color="0x00000000" drawing=on \
		label.width=0 label.padding_right=0 label.padding_right=10 \
		padding_right=0 padding_left=0

media=(
  updates=on
  icon.position=right
  label.position=left
)

sketchybar --add item media_icon right \
	--set media_icon "${media[@]}" \
	icon.font="sketchybar-app-font:Regular:16.0" icon.padding_right=0 padding_right=0 icon.padding_left=0 padding_left=0

sketchybar --add item media right \
           --set media "${media[@]}" script="$PLUGIN_DIR/media.sh" icon=󰐎 \
           --subscribe media media_change

sketchybar --add bracket media_info media_icon media \
	   --set media_info "${bubble_outline[@]}" padding_right=0 

