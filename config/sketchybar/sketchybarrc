	   --set language icon=󰌌 script="$PLUGIN_DIR/language.sh" "${bubble_outline[@]}" label.padding_right=10 icon.font.size="20" \
	   --set language update_freq=1 \
	   --subscribe language mouse.clicked
	   #--subscribe language language_changed

